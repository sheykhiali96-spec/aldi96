{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aldi96",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "6955cfb8-efba-46da-af5b-a10ca0e0fada","database_name": "D1" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "11e764d6220c4c6398c21f547f9d4a5b" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
